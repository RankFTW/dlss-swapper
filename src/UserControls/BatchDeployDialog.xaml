<?xml version="1.0" encoding="utf-8"?>
<usercontrols:FakeContentDialog
    x:Class="DLSS_Swapper.UserControls.BatchDeployDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:usercontrols="using:DLSS_Swapper.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ct_converters="using:CommunityToolkit.WinUI.Converters"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=usercontrols:BatchDeployDialogModel, IsDesignTimeCreatable=False}"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    Title="Batch Deploy">

    <usercontrols:FakeContentDialog.Resources>
        <ct_converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" TrueValue="Visible" FalseValue="Collapsed" />
        <ct_converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" TrueValue="Collapsed" FalseValue="Visible" />
        <ct_converters:BoolNegationConverter x:Key="BoolNegationConverter" />
    </usercontrols:FakeContentDialog.Resources>

    <usercontrols:FakeContentDialog.Content>
        <Grid HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Main content area: split layout -->
            <ContentControl Grid.Row="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            IsEnabled="{x:Bind ViewModel.IsDeploying, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                <Grid ColumnSpacing="20" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left panel: Game selection -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Select All / Deselect All / Hide toggle buttons -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                            <Button Content="Select All" Command="{x:Bind ViewModel.SelectAllCommand}" />
                            <Button Content="Deselect All" Command="{x:Bind ViewModel.DeselectAllCommand}" />
                            <Button Command="{x:Bind ViewModel.ToggleHideHiddenGamesCommand}"
                                    ToolTipService.ToolTip="Toggle hidden games">
                                <Button.Content>
                                    <FontIcon Glyph="{x:Bind ViewModel.HideHiddenGamesGlyph, Mode=OneWay}" />
                                </Button.Content>
                            </Button>
                        </StackPanel>

                        <!-- Scrollable game list -->
                        <ListView Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}"
                                  SelectionMode="None"
                                  MaxHeight="400">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="usercontrols:SelectableGame">
                                    <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                              IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                                              Content="{x:Bind Title, Mode=OneWay}"
                                              MinWidth="0" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- Right panel: DLL version pickers + Streamline toggle -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Spacing="4">

                            <!-- Help message about downloading DLLs -->
                            <TextBlock Text="Download DLL versions from the Library page for them to appear here."
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8" />

                            <!-- DLL pickers in a two-column grid matching GameControl style -->
                            <Grid HorizontalAlignment="Stretch" ColumnSpacing="16" RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- DLSS -->
                                <TextBlock Grid.Column="0" Grid.Row="0" Text="{x:Bind ViewModel.DllTypePickers[0].DisplayName, Mode=OneWay}" FontWeight="Bold" Padding="0,8,0,0" />
                                <ComboBox Grid.Column="0" Grid.Row="1" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.DllTypePickers[0].AvailableRecords, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.DllTypePickers[0].SelectedRecord, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" PlaceholderText="None" />

                                <!-- DLSS Ray Reconstruction -->
                                <TextBlock Grid.Column="1" Grid.Row="0" Text="{x:Bind ViewModel.DllTypePickers[1].DisplayName, Mode=OneWay}" FontWeight="Bold" Padding="0,8,0,0" />
                                <ComboBox Grid.Column="1" Grid.Row="1" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.DllTypePickers[1].AvailableRecords, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.DllTypePickers[1].SelectedRecord, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" PlaceholderText="None" />

                                <!-- DLSS Frame Generation -->
                                <TextBlock Grid.Column="0" Grid.Row="2" Text="{x:Bind ViewModel.DllTypePickers[2].DisplayName, Mode=OneWay}" FontWeight="Bold" Padding="0,8,0,0" />
                                <ComboBox Grid.Column="0" Grid.Row="3" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.DllTypePickers[2].AvailableRecords, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.DllTypePickers[2].SelectedRecord, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" PlaceholderText="None" />

                                <!-- FSR 3.1 DirectX 12 -->
                                <TextBlock Grid.Column="1" Grid.Row="2" Text="{x:Bind ViewModel.DllTypePickers[3].DisplayName, Mode=OneWay}" FontWeight="Bold" Padding="0,8,0,0" />
                                <ComboBox Grid.Column="1" Grid.Row="3" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.DllTypePickers[3].AvailableRecords, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.DllTypePickers[3].SelectedRecord, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" PlaceholderText="None" />

                                <!-- FSR 3.1 Vulkan -->
                                <TextBlock Grid.Column="0" Grid.Row="4" Text="{x:Bind ViewModel.DllTypePickers[4].DisplayName, Mode=OneWay}" FontWeight="Bold" Padding="0,8,0,0" />
                                <ComboBox Grid.Column="0" Grid.Row="5" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.DllTypePickers[4].AvailableRecords, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.DllTypePickers[4].SelectedRecord, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" PlaceholderText="None" />

                                <!-- XeSS -->
                                <TextBlock Grid.Column="1" Grid.Row="4" Text="{x:Bind ViewModel.DllTypePickers[5].DisplayName, Mode=OneWay}" FontWeight="Bold" Padding="0,8,0,0" />
                                <ComboBox Grid.Column="1" Grid.Row="5" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.DllTypePickers[5].AvailableRecords, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.DllTypePickers[5].SelectedRecord, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" PlaceholderText="None" />
                            </Grid>

                            <!-- Second grid for remaining pickers -->
                            <Grid HorizontalAlignment="Stretch" ColumnSpacing="16" RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- XeSS Frame Generation -->
                                <TextBlock Grid.Column="0" Grid.Row="0" Text="{x:Bind ViewModel.DllTypePickers[6].DisplayName, Mode=OneWay}" FontWeight="Bold" Padding="0,8,0,0" />
                                <ComboBox Grid.Column="0" Grid.Row="1" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.DllTypePickers[6].AvailableRecords, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.DllTypePickers[6].SelectedRecord, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" PlaceholderText="None" />

                                <!-- XeSS (DX11) -->
                                <TextBlock Grid.Column="1" Grid.Row="0" Text="{x:Bind ViewModel.DllTypePickers[7].DisplayName, Mode=OneWay}" FontWeight="Bold" Padding="0,8,0,0" />
                                <ComboBox Grid.Column="1" Grid.Row="1" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.DllTypePickers[7].AvailableRecords, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.DllTypePickers[7].SelectedRecord, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" PlaceholderText="None" />

                                <!-- XeLL -->
                                <TextBlock Grid.Column="0" Grid.Row="2" Text="{x:Bind ViewModel.DllTypePickers[8].DisplayName, Mode=OneWay}" FontWeight="Bold" Padding="0,8,0,0" />
                                <ComboBox Grid.Column="0" Grid.Row="3" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.DllTypePickers[8].AvailableRecords, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.DllTypePickers[8].SelectedRecord, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" PlaceholderText="None" />
                            </Grid>

                            <!-- Streamline toggle -->
                            <ToggleSwitch Header="Update Streamline"
                                          IsOn="{x:Bind ViewModel.IsStreamlineUpdateEnabled, Mode=TwoWay}"
                                          IsEnabled="{x:Bind ViewModel.IsStreamlineAvailable, Mode=OneWay}"
                                          Margin="0,12,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </ContentControl>

            <!-- Bottom: Deploy, Restore All, and Close buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
                <Button Content="Deploy"
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.DeployCommand}"
                        IsEnabled="{x:Bind ViewModel.CanDeploy, Mode=OneWay}" />
                <Button Content="Restore All"
                        Command="{x:Bind ViewModel.RestoreAllCommand}"
                        IsEnabled="{x:Bind ViewModel.CanRestore, Mode=OneWay}" />
                <Button Content="Close"
                        Command="{x:Bind ViewModel.CloseCommand}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape" Modifiers="None" />
                    </Button.KeyboardAccelerators>
                </Button>
            </StackPanel>

            <!-- Progress overlay: visible when IsDeploying -->
            <Grid Grid.Row="0" Grid.RowSpan="2"
                  Visibility="{x:Bind ViewModel.IsDeploying, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                  Background="{ThemeResource ContentDialogBackground}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsDeploying, Mode=OneWay}" Width="48" Height="48" />
                    <TextBlock HorizontalAlignment="Center">
                        <Run Text="Updating game " />
                        <Run Text="{x:Bind ViewModel.CurrentGameIndex, Mode=OneWay}" />
                        <Run Text=" of " />
                        <Run Text="{x:Bind ViewModel.TotalGameCount, Mode=OneWay}" />
                        <Run Text="..." />
                    </TextBlock>
                    <TextBlock Text="{x:Bind ViewModel.CurrentGameTitle, Mode=OneWay}"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

        </Grid>
    </usercontrols:FakeContentDialog.Content>

</usercontrols:FakeContentDialog>
